# CUDA variant of the Waldo image — same role switch (app | labeler | trainer)
# as Dockerfile, but on nvidia/cuda + GPU-enabled torch wheels.
#
# Built and published as: docker.io/oldhero5/waldo:cuda

# ── Stage 1: build the React UI ──────────────────────────────────────
FROM node:20-alpine AS ui-builder
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY ui/ ./
RUN mkdir -p /app/static && npm run build

# ── Stage 2: runtime (CUDA base) ─────────────────────────────────────
# Match the cu130 wheel family. Python is managed by uv, not the distro.
# Qualify the resulting image and host driver on the target NVIDIA hardware.
FROM nvidia/cuda:13.0.3-runtime-ubuntu24.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app

COPY pyproject.toml .python-version uv.lock ./
# Use the managed Python version. Install torch/torchvision separately from
# their explicit CUDA wheel index; other dependencies follow the lockfile.
RUN uv sync --frozen --no-dev --group app --group labeler --group trainer \
        --no-install-project --python-preference only-managed \
        --no-install-package torch --no-install-package torchvision

# CUDA 13.0 wheels, pinned to the versions recorded in uv.lock. We do NOT
# follow this with `uv sync` later because that re-reconciles against the
# lockfile and silently strips libcudnn.so.9 off disk, breaking torch.
RUN uv pip install \
    --index-url https://download.pytorch.org/whl/cu130 \
    --extra-index-url https://pypi.org/simple \
    torch==2.12.0 torchvision==0.27.0

COPY lib/ lib/
COPY app/ app/
COPY labeler/ labeler/
COPY trainer/ trainer/
COPY alembic.ini ./
COPY alembic/ alembic/
# Only the runtime entrypoints are needed in the image. Dev scripts
# stay in the repo.
COPY scripts/entrypoint.sh scripts/entrypoint-worker.sh scripts/

COPY --from=ui-builder /app/static /app/app/static

# Install just the Waldo project itself (so `from lib import ...` works
# from alembic + celery + the agent harness). --no-deps is load-bearing:
# any form of dep resolution here will reconcile nvidia-cudnn-cu13 against
# the lockfile and remove libcudnn.so.9 from /app/.venv. See issue #17.
RUN uv pip install --no-deps -e .

COPY scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /app/scripts/entrypoint-worker.sh

ENV DEVICE=cuda \
    DTYPE=bfloat16 \
    WALDO_ROLE=app \
    UV_NO_SYNC=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
