# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=waldo
POSTGRES_PASSWORD=waldo
POSTGRES_DB=waldo

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=waldo
MINIO_SECURE=false
# Host interface the MinIO API (9000) and console (9001) bind to. Defaults to
# 127.0.0.1 so the dev-default minioadmin/minioadmin credentials aren't exposed
# to the LAN. Set to 0.0.0.0 if you need to reach MinIO from another machine.
MINIO_BIND=127.0.0.1

# Hugging Face
HF_TOKEN=

# SAM 3 / 3.1 model selection
# - SAM3_MODEL_ID drives the PyTorch labeler (NVIDIA / CPU). It must point
#   at an HF repo that ships a transformers-compatible model.safetensors.
#   facebook/sam3 satisfies this; facebook/sam3.1 does NOT (it ships only
#   sam3.1_multiplex.pt), so the PyTorch path defaults to sam3 today.
# - SAM3_MLX_MODEL_ID drives the Apple Silicon labeler via MLX, which uses
#   the mlx-community repackage of SAM 3.1 weights.
SAM3_MODEL_ID=facebook/sam3
SAM3_MLX_MODEL_ID=mlx-community/sam3.1-bf16

# AI Agent — shared by agent chat and workflow text blocks.
# Choose ollama, openai, anthropic, vllm, or openrouter. Local Ollama is the
# default. The opt-in Compose local-chat profile pulls AGENT_MODEL.
# Compose sets its internal Ollama URL separately; the Apple local override
# connects to native Ollama through host.docker.internal.
AGENT_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
AGENT_MODEL=gemma4:e4b
AGENT_ALLOWED_MODELS=
AGENT_TIMEOUT_SECONDS=60
# Hosted text providers require both a key and explicit cloud text permission.
# Chat and tool results can contain workspace data. Media is not sent.
AGENT_ALLOW_CLOUD_TEXT=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
VLLM_API_KEY=
VLLM_URL=http://localhost:8001/v1

# Device
DEVICE=mps
DTYPE=float32

# Notifications (all optional)
SLACK_WEBHOOK_URL=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
